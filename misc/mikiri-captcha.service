[Unit]
Description=Mikiri CAPTCHA
After=multi-user.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/mikiri-captcha
ExecStart=/var/www/mikiri-captcha/venv/bin/gunicorn -c init.py api:app -k uvicorn.workers.UvicornWorker
ExecReload=/bin/kill -HUP $MAINPID

[Install]
WantedBy=multi-user.target